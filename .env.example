# PostgreSQL connection string. Any Vercel-friendly Postgres provider works
# (Vercel Postgres, Neon, Supabase). Locally, point this at your own instance.
DATABASE_URL="postgresql://user:password@localhost:5432/inteligencia_natural?schema=public"

# AI generation runs through the Vercel AI Gateway (server-side only, never
# exposed to the browser). On Vercel/v0 this is zero-config via OIDC — leave
# AI_GATEWAY_API_KEY empty. Only set it when running locally outside Vercel;
# create a key at https://vercel.com/ai-gateway
AI_GATEWAY_API_KEY=""

# Optional: override the default model (Gateway `provider/model` id).
# Default is openai/gpt-4.1-mini, which works on the AI Gateway free tier.
# Premium models like anthropic/claude-sonnet-4.5 require paid Gateway credits.
AI_MODEL="openai/gpt-4.1-mini"

# Web search provider for the Pain Researcher agent (https://tavily.com).
# Without this, the Pain Researcher will not run — it never fabricates
# signals when it cannot actually search the web.
TAVILY_API_KEY=""

# Optional: when set, requires this bearer token on /api/agents/* requests
# (matches what Vercel Cron sends automatically). Leave unset for local dev;
# the in-app "Run" buttons never need it since they call server actions
# directly, not these HTTP routes.
CRON_SECRET=""
