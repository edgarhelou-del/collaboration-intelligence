# PostgreSQL connection managed by Vercel/Neon (or any PostgreSQL provider).
DATABASE_URL="postgresql://user:password@localhost:5432/collab_intel?schema=public"

# Optional database overrides. APP_DATABASE_URL wins when present. Otherwise
# the app derives an isolated database name from DATABASE_URL.
APP_DATABASE_URL=""
APP_DB_NAME="collab_intel"

# LLM generation through Groq. Create a provider key and store it only in
# Vercel environment variables or your local .env.local file.
GROQ_API_KEY=""
# Free mode does not use Gateway or Tavily. Keep the Groq account on Free.
FREE_ONLY="true"
ARTICLES_DAILY_LIMIT="100"
# Legacy providers below are used only when FREE_ONLY=false.
# For local Gateway use, set AI_GATEWAY_API_KEY. No automatic paid top-up is enabled.
AI_GATEWAY_API_KEY=""
AI_MODEL="openai/gpt-4.1-mini"
AI_DAILY_CALL_LIMIT="100"
AI_WEEKLY_CALL_LIMIT="500"
AI_MONTHLY_CALL_LIMIT="1500"
GROQ_MODEL="openai/gpt-oss-20b"
GROQ_TIMEOUT_MS="45000"
GROQ_MIN_SPACING_MS="60000"

# Live web search through Tavily.
TAVILY_API_KEY=""
TAVILY_TIMEOUT_MS="20000"
TAVILY_MIN_SPACING_MS="300"

# Maximum searches performed by each researcher in one run.
RESEARCH_MAX_QUERIES="2"

# Application-side provider guardrails. These count calls, not tokens or
# provider credits. A value of 0 disables that window. Provider-side billing
# and spend controls remain authoritative.
GROQ_DAILY_LIMIT="500"
GROQ_WEEKLY_LIMIT="3000"
GROQ_MONTHLY_LIMIT="12000"
TAVILY_DAILY_LIMIT="200"
TAVILY_WEEKLY_LIMIT="700"
TAVILY_MONTHLY_LIMIT="900"

# Required on deployed environments. Vercel Cron sends this value as a Bearer
# token automatically; public agent endpoints return 503 if it is missing in a
# production build. The dashboard's internal buttons do not expose this value.
CRON_SECRET=""

# Shared pause after AI Gateway calls (milliseconds); keeps free-tier bursts small.
AI_MIN_SPACING_MS=20000
