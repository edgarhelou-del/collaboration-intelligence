// Inteligencia Natural — Collaboration Intelligence Radar
//
// Two agents accumulate intelligence over time:
//   - Content Agent writes ContentItem rows.
//   - Pain Researcher writes Signal rows (backed by Company / Person / Source).
// Signal rows are periodically re-aggregated into Pattern rows, which is the
// product's real asset: not the daily content, but the accumulated,
// evolving read on how collaboration is breaking down across organizations.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Users (auth is out of scope for the MVP; this exists so approvals/curation
// actions have somewhere to point once login is added).
// ---------------------------------------------------------------------------

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())

  @@map("users")
}

// ---------------------------------------------------------------------------
// AI usage meter — one row per UTC day, used to enforce a hard daily cap on
// model calls so the app never spends beyond the AI Gateway free tier.
// ---------------------------------------------------------------------------

model AiUsage {
  day       String   @id // UTC date, "YYYY-MM-DD"
  count     Int      @default(0) // model calls made that day
  updatedAt DateTime @updatedAt

  @@map("ai_usage")
}

// ---------------------------------------------------------------------------
// Agent execution log
// ---------------------------------------------------------------------------

enum AgentType {
  CONTENT
  PAIN_RESEARCH
}

enum AgentRunStatus {
  RUNNING
  SUCCESS
  FAILED
  PARTIAL
}

model AgentRun {
  id          String         @id @default(cuid())
  agent       AgentType
  status      AgentRunStatus @default(RUNNING)
  startedAt   DateTime       @default(now())
  finishedAt  DateTime?
  summary     String? // short human-readable outcome, e.g. "10 new signals"
  error       String? // populated on FAILED/PARTIAL — never fabricate around this
  resultCount Int            @default(0)
  metadata    Json? // free-form: search queries used, tokens spent, etc.

  contentItems ContentItem[]
  signals      Signal[]

  @@index([agent, startedAt])
  @@map("agent_runs")
}

// ---------------------------------------------------------------------------
// Content Agent output
// ---------------------------------------------------------------------------

enum ContentStatus {
  DRAFT
  APPROVED
  PUBLISHED
  REJECTED
}

model ContentItem {
  id                 String        @id @default(cuid())
  agentRunId         String?
  agentRun           AgentRun?     @relation(fields: [agentRunId], references: [id], onDelete: SetNull)

  mainIdea           String
  whyItMatters       String
  evidence           Json // [{ text, kind: FACT|INTERPRETATION|HYPOTHESIS, sourceUrl? }]
  businessImplication String
  linkedinPost       String
  alternativeHooks   Json // string[]
  sources            Json // [{ title, url, publisher?, date? }]

  status      ContentStatus @default(DRAFT)
  score       Int           @default(0) // 0-100 editorial quality/insight estimate
  relatedPatternIds Json?  // string[] of Pattern.id this content drew on

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@map("content_items")
}

// ---------------------------------------------------------------------------
// Pain Researcher output
// ---------------------------------------------------------------------------

enum PainCategory {
  COLLABORATION
  SILOS
  COMMUNICATION
  TRUST
  ALIGNMENT
  KNOWLEDGE_SHARING
  CULTURE
  LEADERSHIP
  PSYCHOLOGICAL_SAFETY
  COORDINATION
  HUMAN_AI_COLLABORATION
  OTHER
}

enum EvidenceType {
  DIRECT
  INDIRECT
}

enum SignalStatus {
  NEW
  INVESTIGATING
  RELEVANT
  CONTACTED
  ARCHIVED
}

enum SourceType {
  LINKEDIN
  INTERVIEW
  PODCAST
  CONFERENCE_TALK
  COMPANY_BLOG
  BUSINESS_PUBLICATION
  INDUSTRY_PUBLICATION
  EARNINGS_CALL
  ANNUAL_REPORT
  FORUM
  REDDIT
  YOUTUBE
  OTHER
}

model Company {
  id         String   @id @default(cuid())
  name       String
  industry   String?
  country    String?
  size       String? // e.g. "1-50", "51-200", "201-1000", "1000+"
  createdAt  DateTime @default(now())

  people  Person[]
  signals Signal[]

  @@unique([name])
  @@map("companies")
}

model Person {
  id        String   @id @default(cuid())
  name      String
  role      String? // job title as stated publicly
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())

  signals Signal[]

  @@unique([name, companyId])
  @@map("people")
}

model Source {
  id           String     @id @default(cuid())
  url          String     @unique
  title        String?
  publisherName String?
  sourceType   SourceType @default(OTHER)
  publishedAt  DateTime?
  discoveredAt DateTime   @default(now())

  signals Signal[]

  @@map("sources")
}

model Signal {
  id         String    @id @default(cuid())
  agentRunId String?
  agentRun   AgentRun? @relation(fields: [agentRunId], references: [id], onDelete: SetNull)

  personId  String?
  person    Person?  @relation(fields: [personId], references: [id], onDelete: SetNull)
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  sourceId  String?
  source    Source?  @relation(fields: [sourceId], references: [id], onDelete: SetNull)

  // Denormalized copies of person/company/source fields at discovery time —
  // kept even if the linked row is later merged/edited, so historical
  // scoring stays reproducible.
  personName String
  role       String?
  company_   String  @map("company_name")
  industry   String?
  country    String?
  companySize String?

  painCategory     PainCategory
  patternKey       String // short slug grouping signals into an emerging pattern, e.g. "cross-functional-silos"
  patternLabel     String // human label, e.g. "Cross-functional silos"
  painDescription  String
  evidence         String // exact quote (when appropriate) or clearly-labeled paraphrase
  evidenceType     EvidenceType
  isParaphrase     Boolean      @default(false)

  sourceUrl  String
  sourceName String?
  sourceDate DateTime?

  discoveredAt DateTime @default(now())

  confidenceScore          Int // 0-30 evidence strength
  seniorityScore           Int // 0-20
  organizationalRelevanceScore Int // 0-20
  recencyScore             Int // 0-15
  commercialRelevanceScore Int // 0-15
  overallScore             Int // sum, 0-100

  whyItMatters          String?
  underlyingIssue       String?
  commercialRelevanceNote String?

  status SignalStatus @default(NEW)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([overallScore])
  @@index([painCategory])
  @@index([patternKey])
  @@index([status])
  @@index([discoveredAt])
  @@map("signals")
}

// ---------------------------------------------------------------------------
// Emerging pattern engine — recomputed after each Pain Researcher run.
// ---------------------------------------------------------------------------

model Pattern {
  id    String @id @default(cuid())
  key   String @unique // matches Signal.patternKey
  label String

  painCategory PainCategory

  signalCount        Int
  last30Count        Int
  previous30Count    Int
  growthRate         Float // (last30 - previous30) / max(previous30, 1)
  averageScore        Float

  topIndustries Json // [{ name, count }]
  topCountries  Json // [{ name, count }]
  topRoles      Json // [{ name, count }]

  representativeSignalIds Json // string[]

  firstAppearance DateTime
  latestAppearance DateTime

  aiSynthesis      String? // clearly-labeled AI interpretation, regenerated on recompute
  synthesizedAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("patterns")
}
